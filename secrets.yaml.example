# Copy to secrets.yaml and fill in the two wifi lines. The rest are
# generated and fine as placeholders until you regenerate your own -
# see README.md "Build / flash / OTA" for how.
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

fallback_password: "changeme_fallback_ap_password"
basil_ota_password: "changeme_ota_password"
basil_api_key: "REPLACE_WITH_BASE64_NOISE_PSK="
