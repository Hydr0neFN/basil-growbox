# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml

# Raw capture logs from watch-water.py / trigger-water.py / serial-monitor.ps1.
# These are session evidence, not source, and some contain LAN IPs / MACs.
*.log
